# =====================================================================
# LOGISTICS INTELLIGENCE · copie este arquivo para ".env" e preencha.
# NUNCA publique o arquivo .env. Ele já está no .gitignore.
# Tudo é opcional: sem chaves, o sistema usa só as fontes gratuitas
# (Google Notícias RSS, PNCP, sites oficiais e BrasilAPI) e textos-modelo.
# =====================================================================

# --- Claude API (análise, pesquisa web com fonte e textos personalizados)
# https://console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
# Modelo (padrão: claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5

# --- Busca web (use pelo menos uma para ampliar a cobertura)
# Brave Search API: https://api-dashboard.search.brave.com
BRAVE_API_KEY=
# Serper.dev (resultados do Google): https://serper.dev
SERPER_API_KEY=

# --- Alertas no Telegram (fale com @BotFather e depois veja docs/CONFIGURACAO_APIS.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Alertas por e-mail (para você mesmo; nunca para leads)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# --- Outlook: rascunhos via Microsoft Graph (opcional, exige admin do Microsoft 365)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_MAILBOX=

# --- Banco de dados (opcional). Vazio = SQLite local em data/logistics.db
# Para usar o mesmo banco no PC e na nuvem: PostgreSQL (Neon, Supabase etc.)
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require
DATABASE_URL=
